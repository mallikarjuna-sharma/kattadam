# Copy to `.env.local` in this folder (same directory as package.json / next.config.js).
# Restart `npm run dev` after any change.

# Supabase — used by @kattadam/data-layer in API routes and server code only.

# URL + anon: safe for browser if you add client-side Supabase later.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED for local catalog + admin to read/write your database (same as Netlify env).
# Without this, /api/catalog/* returns "unconfigured" and the app falls back to mock data.
# Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Admin lives at /admin on the same app (optional if you ever split hosts)
# NEXT_PUBLIC_ADMIN_URL=
# NEXT_PUBLIC_CUSTOMER_URL=

# If Node logs "TypeError: fetch failed" to Supabase, `npm run dev` already sets IPv4-first DNS.
# For other commands (e.g. `next start`), you can set:
# NODE_OPTIONS=--dns-result-order=ipv4first

# Local dev: when Supabase is missing or unreachable, enquiries are saved to .data/enquiries.json
# (default in development). Set to 0 to disable; set to 1 to enable outside development.
# ENQUIRY_LOCAL_FALLBACK=1

# After creating a Supabase project, run SQL migrations in order:
# packages/data-layer/supabase/migrations/001_initial.sql … 004_auth_experts_properties.sql
