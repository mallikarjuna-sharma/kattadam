# Copy to `.env.local` in this folder (same directory as package.json / next.config.js).
# Restart `npm run dev` after any change.

# Backend: Lambda Function URL (DynamoDB) — required for catalog, auth, admin
KATTADAM_API_URL=https://YOUR_ID.lambda-url.ap-south-1.on.aws
# Optional: protects /admin/* routes on Lambda (set same value on Lambda env)
# KATTADAM_API_SECRET=

# Supabase — deprecated; remove after cutover
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin lives at /admin on the same app (optional if you ever split hosts)
# NEXT_PUBLIC_ADMIN_URL=
# NEXT_PUBLIC_CUSTOMER_URL=

# If Node logs "TypeError: fetch failed" to Supabase, `npm run dev` already sets IPv4-first DNS.
# For other commands (e.g. `next start`), you can set:
# NODE_OPTIONS=--dns-result-order=ipv4first

# Local dev: when Supabase is missing or unreachable, enquiries are saved to .data/enquiries.json
# (default in development). Set to 0 to disable; set to 1 to enable outside development.
# ENQUIRY_LOCAL_FALLBACK=1

# After creating a Supabase project, run SQL migrations in order:
# packages/data-layer/supabase/migrations/001_initial.sql … 005_email_otp.sql

# Amazon SES — transactional email (signup OTP, password reset)
SES_FROM_EMAIL=noreply@kattadam.in
SES_REGION=ap-south-1

# AWS credentials for SES (use KATTADAM_* on Netlify — AWS_* is reserved there)
KATTADAM_AWS_ACCESS_KEY_ID=
KATTADAM_AWS_SECRET_ACCESS_KEY=
# Local .env.local may use AWS_* instead if you prefer:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Random secret for hashing OTPs in the database (generate once, never change in prod)
# Example: openssl rand -hex 32
OTP_HASH_SECRET=

# Dev only — when SES_FROM_EMAIL is unset, OTP may appear in API responses
# AUTH_DEV_EXPOSE_OTP=1
# AUTH_FIXED_OTP=123456
